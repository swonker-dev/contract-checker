APP_ENV=development
MAX_UPLOAD_MB=10
TOP_K=5

# gigachat, mock или openai_compatible
LLM_PROVIDER=gigachat
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.01
LLM_MAX_OUTPUT_TOKENS=900

# Ключ авторизации из личного кабинета GigaChat API. Не access token.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE_FILE=

# hashing или sentence_transformers
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

REGULATIONS_DIR=data/regulations
ANALYSIS_DB_PATH=data/analyses.sqlite3
